<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.mycompany.app</groupId>
    <artifactId>my-app</artifactId>
    <version>1.0.0</version>
    <name>demo-app</name>
    <description>Multi-architecture Spring Boot demo app</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <!-- Multi-arch build properties -->
        <jib-maven-plugin.version>3.4.0</jib-maven-plugin.version>
        <image.name>mycompany/my-app</image.name>
        <image.tag>${project.version}</image.tag>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <name>${image.name}:${image.tag}</name>
                        <builder>paketobuildpacks/builder-jammy-base:latest</builder>
                        <runImage>paketobuildpacks/run-jammy-base:latest</runImage>
                        <bindings>
                            <binding>${project.basedir}/platform.toml:/platform/bindings/platform.toml</binding>
                        </bindings>
                    </image>
                </configuration>
            </plugin>

            <!-- Jib Plugin for Multi-Architecture Docker Images -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>
                <configuration>
                    <from>
                        <image>eclipse-temurin:17-jre-alpine</image>
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                            <platform>
                                <architecture>arm64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>${image.name}:${image.tag}</image>
                        <tags>
                            <tag>latest</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.mycompany.app.DemoApplication</mainClass>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile for native image compilation with GraalVM -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <imageName>app</imageName>
                            <mainClass>com.mycompany.app.DemoApplication</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--install-exit-handlers</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for ARM64 specific builds -->
        <profile>
            <id>arm64</id>
            <properties>
                <jib.from.platforms>arm64</jib.from.platforms>
            </properties>
        </profile>

        <!-- Profile for AMD64 specific builds -->
        <profile>
            <id>amd64</id>
            <properties>
                <jib.from.platforms>amd64</jib.from.platforms>
            </properties>
        </profile>
    </profiles>

</project>
